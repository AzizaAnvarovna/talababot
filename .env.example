# Nusxa oling: .env. Maxfiy qiymatlarni o'zingiz yarating:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
USER_HASH_SALT=
BOT_API_TOKEN=
# Yaratish: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DELIVERY_KEY=
# @BotFather bergan token.
TELEGRAM_BOT_TOKEN=
API_BASE_URL=http://127.0.0.1:8000

DATABASE_URL=sqlite:///./talababot.db
BACKUP_DIR=backups
# HTTPS da ishlaganda true qiling.
COOKIE_SECURE=false
# Pilotgacha barcha dialoglar test sifatida belgilanadi va hisobotga kirmaydi.
TEST_MODE=true
