[Unit]
Description=TalabaBot Telegram bot
After=network-online.target talababot-web.service
Wants=network-online.target
Requires=talababot-web.service

[Service]
User=talababot
Group=talababot
WorkingDirectory=/opt/talababot
ExecStart=/opt/talababot/.venv/bin/python -m bot.main
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
