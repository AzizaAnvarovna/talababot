limit_req_zone $binary_remote_addr zone=talababot_login:10m rate=6r/m;
limit_req_zone $binary_remote_addr zone=talababot_chat:10m rate=10r/s;

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    client_max_body_size 10m;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;

    # Faqat bot jarayoni 127.0.0.1 orqali ishlatadi.
    location /api/internal/ {
        return 404;
    }

    location = /admin/login {
        limit_req zone=talababot_login burst=5 nodelay;
        limit_req_status 429;
        include /etc/nginx/snippets/talababot-proxy.conf;
    }

    location /api/chat/ {
        limit_req zone=talababot_chat burst=30 nodelay;
        limit_req_status 429;
        include /etc/nginx/snippets/talababot-proxy.conf;
    }

    location / {
        include /etc/nginx/snippets/talababot-proxy.conf;
    }
}
